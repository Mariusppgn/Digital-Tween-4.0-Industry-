{
  "$defs": {
    "GraphPosition": {
      "additionalProperties": false,
      "description": "Editor coordinates persisted with a process step.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "GraphPosition",
      "type": "object"
    },
    "ProcessEdge": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        },
        "provenance": {
          "default": "sylvapapers",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "relation": {
          "default": "forward",
          "enum": [
            "forward",
            "recycle"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "ProcessEdge",
      "type": "object"
    },
    "ProcessNode": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "capacity_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Unit"
        },
        "input_materials": {
          "items": {
            "type": "string"
          },
          "title": "Input Materials",
          "type": "array"
        },
        "kind": {
          "enum": [
            "source",
            "operation",
            "buffer",
            "quality_control",
            "sink"
          ],
          "title": "Kind",
          "type": "string"
        },
        "machine_ids": {
          "items": {
            "type": "string"
          },
          "title": "Machine Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "output_materials": {
          "items": {
            "type": "string"
          },
          "title": "Output Materials",
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "default": "sylvapapers",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "kind",
        "name"
      ],
      "title": "ProcessNode",
      "type": "object"
    },
    "RecyclingConfig": {
      "additionalProperties": false,
      "description": "Bounded quality-loss feedback configured on the process graph.\n\n``recovery_yield`` is interpreted as a Bernoulli recovery probability for\neach atomic simulation unit. Its aggregate realised yield converges to the\nconfigured value over a sufficiently long seeded simulation campaign.",
      "properties": {
        "assumptions_are_synthetic": {
          "default": true,
          "title": "Assumptions Are Synthetic",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_loops": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Loops",
          "type": "integer"
        },
        "provenance": {
          "default": "sylvapapers",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "quantity_unit": {
          "default": "roll_equivalent",
          "minLength": 1,
          "title": "Quantity Unit",
          "type": "string"
        },
        "recovery_yield": {
          "default": 0.75,
          "maximum": 1,
          "minimum": 0,
          "title": "Recovery Yield",
          "type": "number"
        },
        "return_to_node_id": {
          "minLength": 1,
          "title": "Return To Node Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_node_id": {
          "minLength": 1,
          "title": "Source Node Id",
          "type": "string"
        }
      },
      "required": [
        "source_node_id",
        "return_to_node_id"
      ],
      "title": "RecyclingConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/ProcessEdge"
      },
      "minItems": 1,
      "title": "Edges",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ProcessNode"
      },
      "minItems": 2,
      "title": "Nodes",
      "type": "array"
    },
    "provenance": {
      "default": "sylvapapers",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "recycling": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecyclingConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "title": "ProcessGraph",
  "type": "object"
}
