      "title": "Metrics",
      "type": "array"
    },
    "period_end": {
      "format": "date-time",
      "title": "Period End",
      "type": "string"
    },
    "period_start": {
      "format": "date-time",
      "title": "Period Start",
      "type": "string"
    },
    "provenance": {
      "default": "sylvapapers",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
