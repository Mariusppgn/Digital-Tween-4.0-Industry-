    },
    "median_alert_lead_hours": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Median Alert Lead Hours"
    },
    "method": {
      "enum": [
        "ewma_robust",
        "cusum_robust"
      ],
