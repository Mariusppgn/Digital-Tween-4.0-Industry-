      "type": "string"
    },
    "missed_failure_events": {
      "minimum": 0,
      "title": "Missed Failure Events",
      "type": "integer"
    },
    "precision": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
