      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brier Score"
    },
    "censored_points": {
      "minimum": 0,
      "title": "Censored Points",
      "type": "integer"
    },
    "detected_failure_events": {
      "minimum": 0,
      "title": "Detected Failure Events",
      "type": "integer"
    },
    "evaluated_points": {
      "minimum": 0,
      "title": "Evaluated Points",
      "type": "integer"
    },
    "f1_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "F1 Score"
    },
    "failure_events": {
      "minimum": 0,
      "title": "Failure Events",
      "type": "integer"
    },
    "false_negative": {
      "minimum": 0,
      "title": "False Negative",
      "type": "integer"
    },
    "false_positive": {
      "minimum": 0,
      "title": "False Positive",
      "type": "integer"
    },
    "limitations": {
