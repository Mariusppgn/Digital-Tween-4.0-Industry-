{
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "currency": {
      "default": "EUR",
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
    },
    "due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due At"
    },
    "expected_cost": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Cost"
    },
    "intervention_window_end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intervention Window End"
    },
    "intervention_window_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intervention Window Start"
    },
    "machine_id": {
      "minLength": 1,
      "title": "Machine Id",
      "type": "string"
    },
    "policy": {
      "anyOf": [
        {
          "enum": [
            "corrective",
            "preventive",
            "predictive"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy"
    },
    "provenance": {
      "default": "sylvapapers",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "rationale": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Rationale",
      "type": "array"
    },
    "recommendation_id": {
      "minLength": 1,
      "title": "Recommendation Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "urgency": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Urgency",
      "type": "string"
    },
    "variable_importance": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 64,
      "title": "Variable Importance",
      "type": "object"
    }
  },
  "required": [
    "recommendation_id",
    "machine_id",
    "created_at",
    "action",
    "urgency",
    "confidence"
  ],
  "title": "MaintenanceRecommendation",
  "type": "object"
}
