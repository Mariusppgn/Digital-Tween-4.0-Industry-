{
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due At"
    },
    "machine_id": {
      "minLength": 1,
      "title": "Machine Id",
      "type": "string"
    },
    "provenance": {
      "default": "asteria",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "rationale": {
      "items": {
        "type": "string"
      },
      "title": "Rationale",
      "type": "array"
    },
    "recommendation_id": {
      "minLength": 1,
      "title": "Recommendation Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "urgency": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Urgency",
      "type": "string"
    }
  },
  "required": [
    "recommendation_id",
    "machine_id",
    "created_at",
    "action",
    "urgency",
    "confidence"
  ],
  "title": "MaintenanceRecommendation",
  "type": "object"
}
