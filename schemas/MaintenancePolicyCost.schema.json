{
  "additionalProperties": false,
  "description": "Expected cost and downtime for one maintenance policy.",
  "properties": {
    "assumptions_are_synthetic": {
      "default": true,
      "title": "Assumptions Are Synthetic",
      "type": "boolean"
    },
    "currency": {
      "default": "EUR",
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
    },
    "expected_cost": {
      "minimum": 0,
      "title": "Expected Cost",
      "type": "number"
    },
    "expected_downtime_hours": {
      "minimum": 0,
      "title": "Expected Downtime Hours",
      "type": "number"
    },
    "intervention_probability": {
      "maximum": 1,
      "minimum": 0,
      "title": "Intervention Probability",
      "type": "number"
    },
    "policy": {
      "enum": [
        "corrective",
        "preventive",
        "predictive"
      ],
      "title": "Policy",
      "type": "string"
    },
    "provenance": {
      "default": "sylvapapers",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "rationale": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Rationale",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy",
    "expected_cost",
    "expected_downtime_hours",
    "intervention_probability"
  ],
  "title": "MaintenancePolicyCost",
  "type": "object"
}
