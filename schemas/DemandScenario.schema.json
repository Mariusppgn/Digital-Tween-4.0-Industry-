{
  "$defs": {
    "DemandPoint": {
      "additionalProperties": false,
      "properties": {
        "period_start": {
          "format": "date-time",
          "title": "Period Start",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "quantity_unit": {
          "default": "panel",
          "minLength": 1,
          "title": "Quantity Unit",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "period_start",
        "product_id",
        "quantity"
      ],
      "title": "DemandPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/DemandPoint"
      },
      "minItems": 1,
      "title": "Points",
      "type": "array"
    },
    "provenance": {
      "default": "asteria",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "name",
    "points"
  ],
  "title": "DemandScenario",
  "type": "object"
}
