{
  "$defs": {
    "DemandPoint": {
      "additionalProperties": false,
      "properties": {
        "period_start": {
          "format": "date-time",
          "title": "Period Start",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "quantity_unit": {
          "default": "panel",
          "minLength": 1,
          "title": "Quantity Unit",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "period_start",
        "product_id",
        "quantity"
      ],
      "title": "DemandPoint",
      "type": "object"
    },
    "DemandScenario": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/DemandPoint"
          },
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "name",
        "points"
      ],
      "title": "DemandScenario",
      "type": "object"
    },
    "ProductDefinition": {
      "additionalProperties": false,
      "properties": {
        "bill_of_materials": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Bill Of Materials",
          "type": "object"
        },
        "cycle_time_minutes": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Cycle Time Minutes",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "routing": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Routing",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "default": "panel",
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "name",
        "routing"
      ],
      "title": "ProductDefinition",
      "type": "object"
    },
    "ProductionOrder": {
      "additionalProperties": false,
      "properties": {
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "order_id": {
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "priority": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "quantity_unit": {
          "default": "panel",
          "minLength": 1,
          "title": "Quantity Unit",
          "type": "string"
        },
        "release_at": {
          "format": "date-time",
          "title": "Release At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "product_id",
        "quantity",
        "release_at",
        "due_at"
      ],
      "title": "ProductionOrder",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "demand": {
      "anyOf": [
        {
          "$ref": "#/$defs/DemandScenario"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "end_at": {
      "format": "date-time",
      "title": "End At",
      "type": "string"
    },
    "factory_id": {
      "minLength": 1,
      "title": "Factory Id",
      "type": "string"
    },
    "fidelity": {
      "default": "fast",
      "enum": [
        "fast",
        "standard",
        "research"
      ],
      "title": "Fidelity",
      "type": "string"
    },
    "interarrival_time": {
      "default": 0,
      "minimum": 0,
      "title": "Interarrival Time",
      "type": "number"
    },
    "max_reworks": {
      "default": 1,
      "maximum": 5,
      "minimum": 0,
      "title": "Max Reworks",
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/ProductionOrder"
      },
      "title": "Orders",
      "type": "array"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/ProductDefinition"
      },
      "minItems": 1,
      "title": "Products",
      "type": "array"
    },
    "provenance": {
      "default": "asteria",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "random_seed": {
      "default": 42,
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "start_at": {
      "format": "date-time",
      "title": "Start At",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "name",
    "factory_id",
    "start_at",
    "end_at",
    "products"
  ],
  "title": "SimulationScenario",
  "type": "object"
}
