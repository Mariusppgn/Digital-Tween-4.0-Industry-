{
  "$defs": {
    "MachineConfig": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Availability",
          "type": "number"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "capacity_per_hour": {
          "exclusiveMinimum": 0,
          "title": "Capacity Per Hour",
          "type": "number"
        },
        "capacity_unit": {
          "default": "parts/hour",
          "minLength": 1,
          "title": "Capacity Unit",
          "type": "string"
        },
        "machine_id": {
          "minLength": 1,
          "title": "Machine Id",
          "type": "string"
        },
        "machine_type": {
          "minLength": 1,
          "title": "Machine Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "mtbf_hours": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtbf Hours"
        },
        "mttr_hours": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mttr Hours"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "machine_id",
        "name",
        "machine_type",
        "capabilities",
        "capacity_per_hour"
      ],
      "title": "MachineConfig",
      "type": "object"
    },
    "ProcessEdge": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "ProcessEdge",
      "type": "object"
    },
    "ProcessGraph": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/ProcessEdge"
          },
          "minItems": 1,
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ProcessNode"
          },
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "ProcessGraph",
      "type": "object"
    },
    "ProcessNode": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "capacity_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Unit"
        },
        "kind": {
          "enum": [
            "source",
            "operation",
            "buffer",
            "quality_control",
            "rework",
            "sink"
          ],
          "title": "Kind",
          "type": "string"
        },
        "machine_ids": {
          "items": {
            "type": "string"
          },
          "title": "Machine Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "kind",
        "name"
      ],
      "title": "ProcessNode",
      "type": "object"
    },
    "ResourceCalendar": {
      "additionalProperties": false,
      "properties": {
        "exceptions": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Exceptions",
          "type": "object"
        },
        "provenance": {
          "default": "asteria",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "timezone": {
          "default": "Europe/Paris",
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "weekly_shifts": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Weekly Shifts",
          "type": "object"
        }
      },
      "required": [
        "resource_id"
      ],
      "title": "ResourceCalendar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "factory_id": {
      "minLength": 1,
      "title": "Factory Id",
      "type": "string"
    },
    "machines": {
      "items": {
        "$ref": "#/$defs/MachineConfig"
      },
      "minItems": 1,
      "title": "Machines",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "process_graph": {
      "$ref": "#/$defs/ProcessGraph"
    },
    "provenance": {
      "default": "asteria",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "resource_calendars": {
      "items": {
        "$ref": "#/$defs/ResourceCalendar"
      },
      "title": "Resource Calendars",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "timezone": {
      "default": "Europe/Paris",
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "factory_id",
    "name",
    "machines",
    "process_graph"
  ],
  "title": "FactoryConfig",
  "type": "object"
}
