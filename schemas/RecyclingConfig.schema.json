{
  "additionalProperties": false,
  "description": "Bounded quality-loss feedback configured on the process graph.\n\n``recovery_yield`` is interpreted as a Bernoulli recovery probability for\neach atomic simulation unit. Its aggregate realised yield converges to the\nconfigured value over a sufficiently long seeded simulation campaign.",
  "properties": {
    "assumptions_are_synthetic": {
      "default": true,
      "title": "Assumptions Are Synthetic",
      "type": "boolean"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "max_loops": {
      "default": 1,
      "maximum": 20,
      "minimum": 1,
      "title": "Max Loops",
      "type": "integer"
    },
    "provenance": {
      "default": "sylvapapers",
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "quantity_unit": {
      "default": "roll_equivalent",
      "minLength": 1,
      "title": "Quantity Unit",
      "type": "string"
    },
    "recovery_yield": {
      "default": 0.75,
      "maximum": 1,
      "minimum": 0,
      "title": "Recovery Yield",
      "type": "number"
    },
    "return_to_node_id": {
      "minLength": 1,
      "title": "Return To Node Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_node_id": {
      "minLength": 1,
      "title": "Source Node Id",
      "type": "string"
    }
  },
  "required": [
    "source_node_id",
    "return_to_node_id"
  ],
  "title": "RecyclingConfig",
  "type": "object"
}
